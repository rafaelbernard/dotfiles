{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "rafael.workspaces"
        },
        {
          "id": "worldclocks",
          "type": "command",
          "exec": "~/.config/omarchy/bar/modules/worldclocks.sh",
          "interval": 60,
          "fontSize": 9,
          "horizontalMargin": 5
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "resources",
          "type": "command",
          "exec": "~/.config/omarchy/bar/modules/resources.sh",
          "interval": 10,
          "fontSize": 9,
          "horizontalMargin": 5,
          "tooltip": "CPU / RAM / Swap usage"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Auckland",
              "zone": "Pacific/Auckland"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.voxtype.settings"
    }
  ],
  "version": 1
}
