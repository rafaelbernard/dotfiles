#!/bin/sh
# apm with one GitHub token per owner, so personal and IDEXX dependencies both
# resolve whichever gh account is active. Tokens come from gh, are never
# stored, and only exist for this apm process. An account gh doesn't know
# (e.g. IDEXX on the Linux machine) is skipped.
if t=$(gh auth token --user rafaelbernard 2>/dev/null) && [ -n "$t" ]; then
	export GITHUB_APM_PAT_RAFAELBERNARD="$t" GITHUB_APM_PAT_ICONS4U="$t"
fi
if t=$(gh auth token --user Rafael-Araujo_idxx 2>/dev/null) && [ -n "$t" ]; then
	export GITHUB_APM_PAT_IDEXX_LABORATORIES="$t"
fi
exec apm "$@"
